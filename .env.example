APP_ENV=development
APP_VERSION=0.1.0
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=15s

# Production requires a real secret (>= 32 chars) and DATABASE_URL.
JWT_SECRET=dev-only-change-me-to-at-least-32-chars
JWT_TTL=8h

# Seals AI provider API keys at rest (AES-256-GCM). Required (>= 32 chars) in production.
# Generate: openssl rand -base64 48
APP_ENCRYPTION_KEY=dev-only-encryption-key-change-me-32+chars
# Optional: route AI calls through a gateway/proxy instead of the public endpoints.
# AI_OPENAI_BASE_URL=
# AI_GEMINI_BASE_URL=

DATABASE_URL=postgres://postgres:password@localhost:5433/executive_os?sslmode=disable
# Local file store for sealed AI keys when DATABASE_URL is empty.
DUA_DATA_DIR=data

LOG_LEVEL=info
LOG_FORMAT=text

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
